@model YourNamespace.Models.CourseModel

@{
    ViewData["Title"] = "Criar Curso";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0" style="background-color: #1a1a1a;">
                <div class="card-header text-center" style="background-color: #6f42c1; color: white;">
                    <h3>Criar Novo Curso</h3>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label text-white">Título</label>
                            <input asp-for="Title" class="form-control" style="background-color: #2c2c2c; color: white;" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label text-white">Descrição</label>
                            <textarea asp-for="Description" class="form-control" style="background-color: #2c2c2c; color: white;" rows="4"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Price" class="form-label text-white">Preço (R$)</label>
                            <input asp-for="Price" type="number" step="0.01" class="form-control" style="background-color: #2c2c2c; color: white;" />
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>

                        <input asp-for="IdProvider" type="hidden" value="1" />

                        <div class="d-grid">
                            <button type="submit" class="btn" style="background-color: #6f42c1; color: white; font-weight: bold;">Criar Curso</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
