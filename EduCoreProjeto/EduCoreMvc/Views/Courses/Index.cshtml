@model IEnumerable<CourseModel>

@{
    ViewData["Title"] = "Cursos";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container py-5">
    <h1 class="mb-4 text-center">Cursos Disponíveis</h1>
    <div class="row g-4">
        @foreach (var course in Model)
        {
            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@course.Title</h5>
                        <p class="card-text flex-grow-1">@course.Description</p>
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <span class="fw-bold text-primary">R$ @course.Price.ToString("0.00")</span>
                            <a href="#" class="btn btn-sm btn-purple">Comprar</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .btn-purple {
        background-color: #6f42c1;
        color: white;
    }

    .btn-purple:hover {
        background-color: #5930a3;
        color: white;
    }
</style>