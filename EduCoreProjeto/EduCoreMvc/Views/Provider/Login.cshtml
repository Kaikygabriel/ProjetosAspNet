@model EduCoreMvc.Models.Providers.LoginProviderDto

@{
    ViewData["Title"] = "Login";
}

<style>
    body {
        background-color: #f0f4f8;
    }

    .login-container {
        max-width: 460px; /* antes 400px */
        margin: 92px auto; /* antes 80px */
        padding: 34px; /* antes 30px */
        background-color: #ffffff;
        border-radius: 13.8px; /* antes 12px */
        box-shadow: 0 9.2px 23px rgba(0, 0, 0, 0.1); /* antes 0 8px 20px */
        border-top: 5.75px solid #8e44ad; /* antes 5px */
    }

    .login-container h2 {
        text-align: center;
        color: #8e44ad;
        margin-bottom: 28.75px; /* antes 25px */
        font-weight: bold;
        font-size: 1.25rem; /* ligeiro aumento no tamanho do título */
    }

    .form-control:focus {
        border-color: #8e44ad;
        box-shadow: 0 0 0 0.23rem rgba(0, 123, 255, 0.25); /* antes 0.2rem */
    }

    .btn-primary {
        background-color: #8e44ad;
        border-color: #8e44ad;
        width: 100%;
        padding: 0.575rem; /* antes 0.5rem */
        font-size: 1.15rem; /* aumento do texto do botão */
    }

    .btn-primary:hover {
        background-color: #441757;
        border-color: #441757;
    }

    .alert {
        margin-top: 17px; /* antes 15px */
        border-radius: 9.2px; /* antes 8px */
    }
</style>

<div class="login-container">
    <h2>Login</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <form asp-action="Login" method="post">
        <div class="form-group mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" placeholder="Digite seu usuário" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="form-group mb-4">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" type="password" class="form-control" placeholder="Digite sua senha" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Entrar</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}