<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <system.webServer>
        <handlers>
            <remove name="BlibiotecaApiCleanArchitecture"/>
            <add name="BlibiotecaApiCleanArchitecture" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified"/>
        </handlers>
        <aspNetCore processPath="dotnet"
                    arguments="BlibiotecaApiCleanArchitecture.dll"
                    stdoutLogEnabled="true"
                    stdoutLogFile=".\logs\stdout" />
    </system.webServer>
</configuration>






