@model IEnumerable<FilmesViewModel>

@{
    Layout = null;
}


<p>
    <a asp-action="Create" class="btn btn-default btn-success">Create New</a>
</p>

<table class="table table-striped  table-hover">
    <thead>
    <tr class="success">
        <th>@Html.DisplayNameFor(Model => Model.Titulo)</th>

        <th>@Html.DisplayNameFor(Model => Model.Autor)</th>

        <th>@Html.DisplayNameFor(Model => Model.Categoria)</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var i in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(item => i.Titulo)
            </td>

            <td>
                @Html.DisplayFor(item => i.Autor)
            </td>


            <td>
                @Html.DisplayFor(item => i.Categoria)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@i.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@i.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@i.Id">Delete</a>

            </td>
        </tr>
    }
    </tbody>
</table>